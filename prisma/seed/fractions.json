                  "fraction-equivalence:practice-1:v1",
                  "fraction-equivalence:practice-2:v1"
                ]
              }
            }
          ]
        },
        {
          "sectionId": "fraction-equivalence:check:v1",
          "role": "check",
          "title": "약분 혼자 확인하기",
          "contentBlocks": [
            {
              "blockId": "fraction-equivalence:check:problems:v1",
              "kind": "core.problem_set",
              "typeVersion": 2,
              "required": true,
              "payload": {
                "problemSetId": "fraction-equivalence:check",
                "problemSetVersionId": "fraction-equivalence:check:v1",
                "problemVersionIds": [
                  "fraction-equivalence:check-1:v1"
                ]
              }
            }
          ]
        },
        {
          "sectionId": "fraction-equivalence:summary:v1",
          "role": "summary",
          "title": "분자와 분모는 함께 바꿔요",
          "contentBlocks": [
            {
              "blockId": "fraction-equivalence:summary:text:v1",
              "kind": "core.rich_text",
              "typeVersion": 1,
              "required": true,
              "payload": {
                "text": "분자와 분모에 같은 수를 곱하거나 나누면 크기가 같은 분수가 돼요. 한쪽만 바꾸면 일반적으로 값이 달라져요.\n\n약분한 뒤 분자와 분모를 함께 나눌 수 있는 1보다 큰 자연수가 없는지 확인해요. 값이 맞는 것과 문제에서 요구한 모양으로 쓰는 것은 모두 중요해요."
              }
            }
          ]
        }
      ],
