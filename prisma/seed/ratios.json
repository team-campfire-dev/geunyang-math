        "title": "비율만큼의 양: 할인과 이자",
        "summary": "기준량에 비율을 곱해 깎이는 양과 내는 양을 구해요.",
        "estimatedMinutes": 10,
        "conceptKeys": [
          "percentage-of"
        ],
        "prerequisiteConceptKeys": [
          "percentage",
          "rate",
          "decimal-addition"
        ],
        "sectionCount": 5
      },
      "sections": [
        {
          "sectionId": "percentage-of:explanation:v1",
          "role": "explanation",
          "title": "개념 만나기",
