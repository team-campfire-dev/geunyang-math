generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(191)
  displayName  String   @db.VarChar(80)
  /// The course this learner came for. It bounds the starting-point placement and gives the
  /// recommendation a destination. Null until they say, which is a placement over everything.
  targetCourseKey String? @db.VarChar(100)
  /// The three goals this replaced. Nothing reads it; it is kept because one account had chosen
  /// something other than the default and no course maps to it. Dropping it is its own decision.
  goal         String   @default("foundation-recovery") @db.VarChar(40)
  preferredLessonKey String? @db.VarChar(100)
  dailyMinutes Int      @default(10)
  timezone     String   @default("Asia/Seoul") @db.VarChar(80)
  /// Whether the content editor shows the names the system uses — block and version IDs, the
  /// compatibility switches — rather than only what a lesson is made of.
  editorExpertMode Boolean @default(false)
  createdAt    DateTime @default(now())
  learningScopes LearningScope[]
  sessions     Session[]
  googleIdentity GoogleIdentity?
  enrollments  Enrollment[]
  recipients   AssignmentRecipient[]
  attempts     Attempt[]
  hints        HintUse[]
  diagnostics  DiagnosticRun[]
  recommendationHistory RecommendationHistory[]
  contentAuthor ContentAuthor?
  contentDrafts ContentDraft[]
}

/// Permission to write content, held as a role on an account rather than as a property of the one
/// operator. A teacher system grants content work by writing rows here; routes and screens ask for
/// the role, never for a particular person.
model ContentAuthor {
  userId    String @id @db.VarChar(191)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String @db.VarChar(20)
  grantedAt DateTime @default(now())
}

/// A working copy of something that is frozen when published: a lesson or a problem set. Publishing
/// copies the draft into a new version; a draft is never the record a learner reads. A lesson draft
/// names the problem set drafts it publishes with, by the version ids its blocks reference.
model ContentDraft {
  id                 String @id @default(cuid()) @db.VarChar(191)
  /// 'lesson' | 'problem_set' | 'diagnostic'
  ownerKind          String @db.VarChar(20)
  /// Lesson.key, ProblemSet.id or Diagnostic.key
  ownerKey           String @db.VarChar(191)
  versionId          String @db.VarChar(191)
  baseVersionId      String? @db.VarChar(191)
  title              String @db.VarChar(191)
  document           Json
  status             String @default("draft") @db.VarChar(20)
  authorId           String @db.VarChar(191)
  author             User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedVersionId String? @db.VarChar(191)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([ownerKind, ownerKey])
  @@index([authorId, updatedAt])
}

model DiagnosticRun {
  id          String @id @default(cuid()) @db.VarChar(191)
  userId      String @db.VarChar(191)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     String @db.VarChar(80)
  document    Json
  answers     Json
  /// What the run settled and how, frozen as it was decided. Null for a run started before
  /// placement descended a graph, which reads as having settled nothing.
  placement   Json?
  status      String @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  @@unique([userId, version])
}

model RecommendationHistory {
  id          String @id @default(cuid()) @db.VarChar(191)
  userId      String @db.VarChar(191)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String @db.VarChar(64)
  trigger     String @db.VarChar(40)
  snapshot    Json
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
}

model LearningScope {
  id          String @id @default(cuid()) @db.VarChar(191)
  kind        String @db.VarChar(20)
  ownerUserId String? @unique @db.VarChar(191)
  owner       User? @relation(fields: [ownerUserId], references: [id])
  enrollments Enrollment[]
  assignments Assignment[]
  attempts    Attempt[]
}

model Session {
  id        String @id @default(cuid()) @db.VarChar(191)
  tokenHash String @unique @db.VarChar(64)
  userId    String @db.VarChar(191)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  authMethod String @default("development") @db.VarChar(20)
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

/// A course is the bundle a lesson, a problem set or a diagnostic belongs to — nothing floats
/// outside one. It is not frozen: its title and the order of its lessons change in place.
model Course {
  id          String   @id @default(cuid()) @db.VarChar(191)
  key         String   @unique @db.VarChar(100)
  title       String   @db.VarChar(191)
  summary     String   @default("") @db.VarChar(500)
  /// Where the course sits in the catalogue. The catalogue's order is the only thing a learner who
  /// has chosen nothing is recommended by, so it is written down rather than left to install order.
  order       Int      @default(0)
  /// Which line of study the course belongs to. The catalogue is ordered along one line — school
  /// mathematics — and a course beside that line is chosen on purpose rather than met on the way,
  /// so what places a learner who has chosen nothing only ever asks along the default one.
  track       String   @default("middle") @db.VarChar(40)
  /// The school year inside the track. Only 중학교 and 고등학교 have one.
  stage       String?  @db.VarChar(40)
  /// Who keeps the course. Null is the platform's own; organisations have no model yet.
  ownerUserId String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  diagnostics Diagnostic[]
  problemSets ProblemSet[]
}

/// The identity of a problem set: which course keeps it, and its name. A name is the declaration
/// that it is meant to be reused; a set made in place while writing a lesson has none and is not
/// listed. A question belongs to exactly one problem set, however many lessons reference it.
model ProblemSet {
  id        String   @id @db.VarChar(191)
  courseId  String   @db.VarChar(191)
  course    Course   @relation(fields: [courseId], references: [id])
  name      String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  versions  ProblemSetVersion[]
  @@index([courseId])
}

/// A frozen problem set. Its questions are rows of PublishedProblem and their blocks rows of
/// ContentBlock, both hanging off this id, which therefore shares the namespace of version ids.
model ProblemSetVersion {
  id           String     @id @db.VarChar(191)
  problemSetId String     @db.VarChar(191)
  problemSet   ProblemSet @relation(fields: [problemSetId], references: [id])
  contentHash  String     @db.VarChar(64)
  publishedAt  DateTime   @default(now())
  assignments  Assignment[]
  diagnostics  DiagnosticVersion[]
  @@index([problemSetId, publishedAt])
}

/// The identity of a lesson, apart from any version of it: which course keeps it and where it
/// stands in that course. A row exists from the first draft, so a lesson has a course before it
/// has a version; a lesson with no version is one nobody has published yet.
model Lesson {
  key       String   @id @db.VarChar(100)
  courseId  String   @db.VarChar(191)
  course    Course   @relation(fields: [courseId], references: [id])
  order     Int
  createdAt DateTime @default(now())
  versions  LessonVersion[]
  @@index([courseId, order])
}

/// The identity of a diagnostic: which course keeps it. Versions hang off it as they do a lesson.
model Diagnostic {
  key      String @id @db.VarChar(100)
  courseId String @db.VarChar(191)
  course   Course @relation(fields: [courseId], references: [id])
  versions DiagnosticVersion[]
}

model LessonVersion {
  id          String @id @db.VarChar(191)
  lessonKey   String @db.VarChar(100)
  lesson      Lesson @relation(fields: [lessonKey], references: [key])
  title       String @db.VarChar(191)
  /// Everything a lesson says about itself that is not a section or a block — `public`, and `review`,
  /// the problem set its review assignments draw from. Questions are the problem sets' now.
  metadata    Json
  contentHash String @db.VarChar(64)
  publishedAt DateTime @default(now())
  enrollments Enrollment[]
  @@index([lessonKey])
}

/**
 * Every question a published version holds, by name. A draft asks whether editing a question in
 * place would change what an already answered question meant, and that is a lookup by name — not a
 * reason to read every published document. With its blocks it is also the whole of the question.
 */
model PublishedProblem {
  /// Always 'problem_set': every published question belongs to a problem set version.
  ownerKind        String @db.VarChar(20)
  ownerVersionId   String @db.VarChar(191)
  problemVersionId String @db.VarChar(191)
  /// The position the version holds this question in. A question list is ordered.
  order            Int
  conceptKeys      Json
  /// What the question expects and how it is marked. Both follow from the answer, but they are
  /// stored as they were published rather than derived again at read time.
  responseSpec     Json
  gradingSpec      Json
  hintAvailable    Boolean
  /// Wrong answers this question was built to catch, each with the name of the mistake behind it.
  /// Not frozen with the version — it changes nothing about what was asked, what the answer is, or
  /// how the answer is marked, so it may be written onto a question that is already published.
  misreadings      Json?
  @@id([ownerKind, ownerVersionId, problemVersionId])
  @@index([problemVersionId])
  @@index([ownerKind, ownerVersionId, order])
}

/**
 * A section of a published class, in the order the class shows it, and every content block a
 * published class holds — a section's body, or a question's prompt, hints and solution. The class
 * document is still the record these are derived from; nothing reads them yet.
 */
model LessonSection {
  lessonVersionId String @db.VarChar(191)
  sectionId      String @db.VarChar(191)
  role           String @db.VarChar(20)
  title          String @db.VarChar(500)
  order          Int
  @@id([lessonVersionId, sectionId])
  @@index([lessonVersionId, order])
}

model ContentBlock {
  ownerKind      String @db.VarChar(20)
  ownerVersionId String @db.VarChar(191)
  ownerId        String @db.VarChar(191)
  slot           String @db.VarChar(20)
  order          Int
  blockId        String @db.VarChar(191)
  kind           String @db.VarChar(100)
  typeVersion    Int
  required       Boolean
  payload        Json
  /// Absent in the document rather than empty, so a row that restores it as null would change the
  /// version's content hash. It is written and read back as "no key at all".
  fallback       String? @db.Text
  @@id([ownerKind, ownerVersionId, ownerId, slot, order])
  @@index([ownerVersionId])
  /// A published version that still uses a block form is the reason that form cannot be removed.
  @@index([kind, typeVersion])
}

/// A concept: what mathematics named, and the axis a learner's readiness travels on across courses.
/// The key is global and never moves; only how a scope calls it and explains it differs. Whether a
/// question may assess it is the concept's own, not a scope's.
model Concept {
  key         String   @id @db.VarChar(100)
  /// The shared dictionary's name for it; a scope may call it something else in its definition row.
  label       String   @db.VarChar(191)
  assessable  Boolean
  createdAt   DateTime @default(now())
  definitions ConceptDefinition[]
}

/// How one scope calls and explains a concept. Not frozen and without a draft: saving is the latest,
/// because a definition decides nothing — it is not recorded as help and not used to personalise —
/// so there is no past to recover. The body is rows of ContentBlock hanging off this row's id, which
/// therefore shares the namespace of version ids.
model ConceptDefinition {
  id         String   @id @default(cuid()) @db.VarChar(191)
  conceptKey String   @db.VarChar(100)
  concept    Concept  @relation(fields: [conceptKey], references: [key])
  /// ConceptScope: global | organization | course | lesson.
  scopeKind  String   @db.VarChar(20)
  scopeKey   String   @default("") @db.VarChar(100)
  /// What this scope calls the concept. Null means the concept's own label.
  label      String?  @db.VarChar(191)
  /// Optional summary. The full explanation and its mathematical conditions live in blocks.
  summary    String?  @db.VarChar(500)
  /// Mathematical setting of this explanation; not a difficulty or learner grade.
  usageNote  String?  @db.VarChar(500)
  updatedAt  DateTime @updatedAt
  @@unique([conceptKey, scopeKind, scopeKey])
  @@index([scopeKind, scopeKey])
}

/** Applied reviewed bundles, like a migration ledger: an unchanged file is never replayed. */
model AppliedContentBundle {
  name      String @id @db.VarChar(191)
  checksum  String @db.VarChar(64)
  appliedAt DateTime @default(now())
}

model DiagnosticVersion {
  id               String @id @db.VarChar(191)
  diagnosticKey    String @db.VarChar(100)
  diagnostic       Diagnostic @relation(fields: [diagnosticKey], references: [key])
  title            String @db.VarChar(191)
  description      String @db.Text
  estimatedMinutes Int
  /// The questions come from one frozen problem set version, asked in this order.
  problemSetId        String @db.VarChar(191)
  problemSetVersionId String @db.VarChar(191)
  problemSetVersion   ProblemSetVersion @relation(fields: [problemSetVersionId], references: [id])
  problemVersionIds   Json
  contentHash      String @db.VarChar(64)
  publishedAt      DateTime @default(now())
  @@index([diagnosticKey, publishedAt])
}

model Enrollment {
  id                  String @id @default(cuid()) @db.VarChar(191)
  userId              String @db.VarChar(191)
  user                User @relation(fields: [userId], references: [id])
  scopeId             String @db.VarChar(191)
  learningScope               LearningScope @relation(fields: [scopeId], references: [id])
  lessonVersionId      String @db.VarChar(191)
  lessonVersion        LessonVersion @relation(fields: [lessonVersionId], references: [id])
  completedSectionIds Json
  status              String @default("active") @db.VarChar(20)
  createdAt           DateTime @default(now())
  completedAt         DateTime?
  attempts            Attempt[]
  sourceRecipients    AssignmentRecipient[]
  @@unique([userId, lessonVersionId])
}

model Assignment {
  id                   String @id @default(cuid()) @db.VarChar(191)
  ownerScopeId         String @db.VarChar(191)
  learningScope                LearningScope @relation(fields: [ownerScopeId], references: [id])
  title                String @db.VarChar(191)
  issuerType           String @default("system") @db.VarChar(20)
  sourceLessonVersionId String? @db.VarChar(191)
  /// The questions usually come from one frozen problem set version, and an item only picks and
  /// orders them. A set gathered for one learner — every question in the catalogue built to catch
  /// one mistake — comes from several, so it names none and these are null.
  problemSetId         String? @db.VarChar(191)
  problemSetVersionId  String? @db.VarChar(191)
  problemSetVersion    ProblemSetVersion? @relation(fields: [problemSetVersionId], references: [id])
  // How it is taken (kind, hints, results, solutions) and when it opens and is due. The reasons
  // behind a system-issued review stay in policySnapshot.
  policy               Json
  schedule             Json
  policySnapshot       Json
  issuedAt             DateTime?
  items                AssignmentItem[]
  recipients           AssignmentRecipient[]
}

model AssignmentItem {
  id               String @id @default(cuid()) @db.VarChar(191)
  assignmentId     String @db.VarChar(191)
  assignment       Assignment @relation(fields: [assignmentId], references: [id])
  problemVersionId String @db.VarChar(191)
  position         Int
  attempts         Attempt[]
  submissions      SubmissionItem[]
  @@unique([assignmentId, position])
}

model AssignmentRecipient {
  id                 String @id @default(cuid()) @db.VarChar(191)
  assignmentId       String @db.VarChar(191)
  assignment         Assignment @relation(fields: [assignmentId], references: [id])
  learnerUserId      String @db.VarChar(191)
  learner            User @relation(fields: [learnerUserId], references: [id])
  sourceEnrollmentId String? @unique @db.VarChar(191)
  sourceEnrollment   Enrollment? @relation(fields: [sourceEnrollmentId], references: [id])
  recommendedAt      DateTime
  // Set only when this person's window differs from the assignment's schedule.
  opensAt            DateTime?
  dueAt              DateTime?
  status             String @default("assigned") @db.VarChar(20)
  submissions        Submission[]
  @@unique([assignmentId, learnerUserId])
}

model Submission {
  id              String @id @default(cuid()) @db.VarChar(191)
  recipientId     String @db.VarChar(191)
  recipient       AssignmentRecipient @relation(fields: [recipientId], references: [id])
  submissionIndex Int @default(1)
  status          String @default("draft") @db.VarChar(20)
  finalizedAt     DateTime?
  requestId       String? @db.VarChar(100)
  attempts        Attempt[]
  items           SubmissionItem[]
  @@unique([recipientId, submissionIndex])
}

model Attempt {
  id               String @id @default(cuid()) @db.VarChar(191)
  userId           String @db.VarChar(191)
  user             User @relation(fields: [userId], references: [id])
  scopeId          String @db.VarChar(191)
  learningScope            LearningScope @relation(fields: [scopeId], references: [id])
  enrollmentId     String? @db.VarChar(191)
  enrollment       Enrollment? @relation(fields: [enrollmentId], references: [id])
  submissionId     String? @db.VarChar(191)
  submission       Submission? @relation(fields: [submissionId], references: [id])
  assignmentItemId String? @db.VarChar(191)
  assignmentItem   AssignmentItem? @relation(fields: [assignmentItemId], references: [id])
  problemVersionId String @db.VarChar(191)
  answer           String @db.VarChar(128)
  result           Json
  hintUsed         Boolean @default(false)
  requestId        String @db.VarChar(100)
  createdAt        DateTime @default(now())
  selectedIn       SubmissionItem[]
  revisions        AssessmentRevision[]
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model SubmissionItem {
  id               String @id @default(cuid()) @db.VarChar(191)
  submissionId     String @db.VarChar(191)
  submission       Submission @relation(fields: [submissionId], references: [id])
  assignmentItemId String @db.VarChar(191)
  assignmentItem   AssignmentItem @relation(fields: [assignmentItemId], references: [id])
  selectedAttemptId String @db.VarChar(191)
  selectedAttempt Attempt @relation(fields: [selectedAttemptId], references: [id])
  @@unique([submissionId, assignmentItemId])
}

model HintUse {
  id               String @id @default(cuid()) @db.VarChar(191)
  userId           String @db.VarChar(191)
  user             User @relation(fields: [userId], references: [id])
  contextKind      String @db.VarChar(20)
  contextId        String @db.VarChar(191)
  problemVersionId String @db.VarChar(191)
  createdAt        DateTime @default(now())
  @@unique([userId, contextKind, contextId, problemVersionId])
}

model AssessmentRevision {
  id              String @id @default(cuid()) @db.VarChar(191)
  attemptId       String @db.VarChar(191)
  attempt         Attempt @relation(fields: [attemptId], references: [id])
  correctedResult Json
  reason          String @db.Text
  createdAt       DateTime @default(now())
}

// Google subject is case-sensitive ASCII (the migration pins its collation).
model GoogleIdentity {
  subject String @id @db.VarChar(255)
  userId String @unique @db.VarChar(191)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Short-lived authorization request; never stores provider access or refresh tokens.
model OAuthAttempt {
  stateHash String @id @db.VarChar(64)
  browserHash String @db.VarChar(64)
  codeVerifier String @db.VarChar(128)
  nonce String @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([browserHash])
}
