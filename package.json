{
  "name": "geunyang-math",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3017",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "brand:images": "python3 scripts/build-brand-images.py",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:mobile",
    "content:import": "node --conditions=react-server --import tsx scripts/content.ts import",
    "content:export": "node --conditions=react-server --import tsx scripts/content.ts export",
    "content:publish": "node --conditions=react-server --import tsx scripts/content.ts publish",
    "content:verify": "node --conditions=react-server --import tsx scripts/content.ts verify",
    "content:retire": "node --conditions=react-server --import tsx scripts/content.ts retire",
    "content:lock": "node --import tsx scripts/content-lock.ts",
    "pilot:report": "node --conditions=react-server --import tsx scripts/pilot.ts",
    "problems:check": "node --conditions=react-server --import tsx scripts/check-problems.ts",
    "guide:sync": "node --import tsx scripts/writing-guide.ts",
    "problems:generate": "node --conditions=react-server --import tsx scripts/generate-problems.ts",
    "compare:solutions": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/compare-solutions.ts",
    "lessons:rewrite": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/rewrite-lessons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "google-auth-library": "11.0.2",
    "katex": "0.18.10",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "prisma": "7.10.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
