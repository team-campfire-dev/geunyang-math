{
  "name": "geunyang-math",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3017",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:mobile",
    "content:import": "node --conditions=react-server --import tsx scripts/content.ts import",
    "content:export": "node --conditions=react-server --import tsx scripts/content.ts export",
    "content:verify": "node --conditions=react-server --import tsx scripts/content.ts verify"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "google-auth-library": "11.0.2",
    "katex": "0.17.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.4.7"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.23.1"
    }
  }
}
