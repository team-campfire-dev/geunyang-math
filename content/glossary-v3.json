  "definitions": [
    {
      "conceptKey": "fraction",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "분수",
      "summary": "여기서는 정수 a와 0이 아닌 정수 b로 a/b처럼 수를 나타낸 표현을 말해요.",
      "blocks": [
        {
          "blockId": "global:fraction:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "정수 $a$와 0이 아닌 정수 $b$로 $\\frac{a}{b}$처럼 나타내는 수예요. 처음에는 전체 하나를 똑같이 나눈 조각으로 이해할 수 있어요. $\\frac{3}{4}$은 4등분한 조각 3개예요. 분수는 1보다 클 수도 있어요. $\\frac{5}{4}$은 같은 조각 5개이므로 $1\\frac{1}{4}$이에요.",
            "definitions": [
              {
                "conceptKey": "integer",
                "surface": "정수"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "numerator",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "분자",
      "summary": "분수에서 가로선 위에 쓰는 수예요.",
      "blocks": [
        {
          "blockId": "global:numerator:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "분수 $\\frac{3}{4}$에서 위의 3이 분자예요. 전체를 똑같이 나눈 상황에서는 그 조각을 몇 개 세었는지 나타내요. $\\frac{5}{4}$의 분자는 5이고, 전체 하나보다 많은 양도 나타낼 수 있어요.",
            "definitions": [
              {
                "conceptKey": "fraction",
                "surface": "분수"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "denominator",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "분모",
      "summary": "분수에서 가로선 아래에 쓰는 0이 아닌 수예요.",
      "blocks": [
        {
          "blockId": "global:denominator:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "분수 $\\frac{3}{4}$에서 아래의 4가 분모예요. 전체 하나를 똑같이 나눈 상황에서는 전체를 몇 조각으로 나눴는지 나타내요. 분모가 4이면 한 조각은 전체의 $\\frac{1}{4}$이에요. 0으로 나눌 수 없으므로 분모는 0이 될 수 없어요.",
            "definitions": [
              {
                "conceptKey": "fraction",
                "surface": "분수"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "equivalent-fraction",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "동치분수",
      "summary": "모양은 달라도 값이 같은 분수예요.",
      "blocks": [
        {
          "blockId": "global:equivalent-fraction:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "같은 전체에서 $\\frac{1}{2}$과 $\\frac{2}{4}$은 같은 양을 나타내는 동치분수예요. 분자와 분모에 같은 0이 아닌 수를 곱하거나 나누어도 값은 변하지 않아요.",
            "definitions": [
              {
                "conceptKey": "numerator",
                "surface": "분자"
              },
              {
                "conceptKey": "denominator",
                "surface": "분모"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "reduce",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "약분",
      "summary": "분자와 분모를 같은 공약수로 나누어 간단히 나타내는 것이에요.",
      "blocks": [
        {
          "blockId": "global:reduce:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "$\\frac{6}{9}$의 분자와 분모를 3으로 나누면 $\\frac{2}{3}$이에요. 이렇게 두 수를 같은 공약수로 나누는 것이 약분이에요. 더 이상 약분할 수 없을 때까지 나누면 기약분수가 돼요.",
            "definitions": [
              {
                "conceptKey": "numerator",
                "surface": "분자"
              },
              {
                "conceptKey": "denominator",
                "surface": "분모"
              },
              {
                "conceptKey": "common-divisor",
                "surface": "공약수"
              },
              {
                "conceptKey": "irreducible-fraction",
                "surface": "기약분수"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "common-denominator",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "통분",
      "summary": "여러 분수의 분모가 같도록 동치분수로 바꾸는 것이에요.",
      "blocks": [
        {
          "blockId": "global:common-denominator:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "$\\frac{1}{2}$과 $\\frac{1}{3}$의 분모를 6으로 맞추면 $\\frac{3}{6}$과 $\\frac{2}{6}$이 돼요. 이를 통분이라고 해요. 분모만 바꾸지 않고 분자에도 같은 수를 곱해야 각각의 값이 그대로예요.",
            "definitions": [
              {
                "conceptKey": "numerator",
                "surface": "분자"
              },
              {
                "conceptKey": "denominator",
                "surface": "분모"
              }
            ]
          }
        }
      ],
      "usageNote": "정수로 나타내는 분수와 그 연산"
    },
    {
      "conceptKey": "addition",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "덧셈",
      "summary": "두 수나 양을 합하는 연산이에요.",
      "blocks": [
        {
          "blockId": "global:addition:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "$3+2=5$처럼 수나 양을 합하는 것을 덧셈이라고 해요. 길이끼리, 같은 단위의 양끼리 더해요. 분수도 같은 단위로 맞추면 $\\frac{1}{4}+\\frac{2}{4}=\\frac{3}{4}$처럼 더할 수 있어요.",
            "definitions": [
              {
                "conceptKey": "fraction",
                "surface": "분수"
              }
            ]
          }
        }
      ],
      "usageNote": "수와 같은 단위의 양을 더하는 맥락"
    },
    {
      "conceptKey": "integer",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "정수",
      "usageNote": "수의 범위",
      "blocks": [
        {
          "blockId": "global:integer:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "정수는 $\\ldots,-3,-2,-1,0,1,2,3,\\ldots$처럼 0과 양의 정수, 음의 정수를 모두 모아 부르는 이름이에요. $-2$, $0$, $5$는 정수이고 $\\frac{1}{2}$은 정수가 아니에요.",
            "definitions": []
          }
        }
      ]
    },
    {
      "conceptKey": "common-divisor",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "공약수",
      "usageNote": "양의 정수의 약수를 다루는 맥락",
      "blocks": [
        {
          "blockId": "global:common-divisor:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "두 개 이상의 양의 정수를 각각 나누었을 때 나머지가 0인 양의 정수를 공약수라고 해요. 6과 9의 공약수는 1과 3이에요.",
            "definitions": [
              {
                "conceptKey": "integer",
                "surface": "정수"
              }
            ]
          }
        }
      ]
    },
    {
      "conceptKey": "irreducible-fraction",
      "scopeKind": "global",
      "scopeKey": "",
      "label": "기약분수",
      "usageNote": "정수로 나타낸 분수, 분모는 0이 아님",
      "blocks": [
        {
          "blockId": "global:irreducible-fraction:body",
          "kind": "core.rich_text",
          "typeVersion": 3,
          "required": true,
          "payload": {
            "text": "분자와 분모가 정수인 분수에서, 분자와 분모의 절댓값에 1보다 큰 공약수가 없으면 기약분수라고 해요. $\\frac{2}{3}$은 기약분수이고 $\\frac{6}{9}$는 3으로 약분할 수 있어요.",
            "definitions": [
              {
                "conceptKey": "numerator",
                "surface": "분자"
              },
              {
                "conceptKey": "denominator",
                "surface": "분모"
              },
              {
                "conceptKey": "integer",
                "surface": "정수"
              },
              {
                "conceptKey": "common-divisor",
                "surface": "공약수"
              },
              {
                "conceptKey": "reduce",
                "surface": "약분"
              }
            ]
          }
        }
      ]
    }
  ]
}
