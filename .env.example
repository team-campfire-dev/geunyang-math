# Local-only credentials for the isolated docker-compose.yml database.
DATABASE_URL=mysql://geunyang:local-development-only@127.0.0.1:3317/geunyang_math
DEV_LOGIN_ENABLED=true
APP_ORIGIN=http://127.0.0.1:3017
# Google OAuth: server-only values for this project's dedicated Web application client.
# Register exactly APP_ORIGIN/api/auth/google/callback as an authorized redirect URI.
# Production requires an HTTPS APP_ORIGIN and DEV_LOGIN_ENABLED=false.
# The default local setup uses development login until Google is explicitly configured.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Never use NEXT_PUBLIC_ for OAuth secrets or put auth codes/tokens/cookies in logs.
# Optional mobile static build API URL. A real mobile deployment needs its own auth adapter.
# NEXT_PUBLIC_API_ORIGIN=https://your-geunyang-api.example
# TEST_DATABASE_URL points at a separate disposable test database, never production.
