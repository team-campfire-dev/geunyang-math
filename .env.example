# Local-only credentials for the isolated docker-compose.yml database.
DATABASE_URL=mysql://geunyang:local-development-only@127.0.0.1:3317/geunyang_math
DEV_LOGIN_ENABLED=true
APP_ORIGIN=http://127.0.0.1:3017
# Optional mobile static build API URL. A real mobile deployment needs its own auth adapter.
# NEXT_PUBLIC_API_ORIGIN=https://your-geunyang-api.example
# TEST_DATABASE_URL points at a separate disposable test database, never production.
